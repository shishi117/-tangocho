rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 単一利用者前提: 許可UIDを直書き。追加/変更はこのファイルを編集して再デプロイ。
    function isAllowed() {
      return request.auth != null
        && request.auth.uid in ['<OWNER_UID>'];
    }
    function isOwner(doc) {
      return isAllowed() && doc.owner == request.auth.uid;
    }

    match /cards/{cardId} {
      allow read: if isOwner(resource.data);
      allow create: if isAllowed() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isOwner(resource.data);
    }

    match /decks/{deckId} {
      allow read: if isOwner(resource.data);
      allow write: if isAllowed() && request.resource.data.owner == request.auth.uid;
    }

    // 設定（習得閾値・最低回答数・セッション枚数 = BG-2）。所有者のみ。
    match /settings/{settingsId} {
      allow read: if isOwner(resource.data);
      allow write: if isAllowed() && request.resource.data.owner == request.auth.uid;
    }

    // 既定は全遮断。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
